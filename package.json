{
  "name": "dsh-envdock",
  "version": "0.6.0",
  "description": "EnvDock · Windows 工具链码头：自动探测 Node/Python/Git 与终端，选默认版本，把环境简报喂给 AI。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "windows",
    "toolchain",
    "environment"
  ],
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tkochj/dsh-envdock.git"
  },
  "bugs": {
    "url": "https://github.com/tkochj/dsh-envdock/issues"
  },
  "homepage": "https://github.com/tkochj/dsh-envdock#readme",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "scripts": {
    "test": "node test/parsers.mjs && node test/i18n-check.mjs && node test/host-harness.mjs && node test/panel-render.mjs && node test/family.mjs"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "engines": {
    "dsh": ">=0.2.0"
  }
}
